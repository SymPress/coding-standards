<?xml version="1.0"?>
<ruleset
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd"
    name="SymPress-Enterprise-Next"
>

    <description>Strictest SymPress profile for new WordPress codebases on PHP 8.5+ and WordPress 7.0+.</description>

    <rule ref="SymPress-WordPress" />

    <config name="testVersion" value="8.5-" />
    <config name="minimum_wp_version" value="7.0" />
</ruleset>
