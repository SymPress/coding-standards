<?xml version="1.0"?>
<ruleset
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd"
    name="SymPress-Enterprise-LTS"
>

    <description>Enterprise adoption profile for conservative WordPress stacks running PHP 8.2+ and WordPress 6.5+.</description>

    <rule ref="SymPress-WordPress" />

    <config name="testVersion" value="8.2-" />
    <config name="minimum_wp_version" value="6.5" />

    <rule ref="SymPress.Classes.AccessorNaming">
        <type>warning</type>
    </rule>
    <rule ref="SymPress.Classes.PropertyLimit">
        <type>warning</type>
    </rule>
    <rule ref="SymPress.ControlStructures.DisallowElse">
        <type>warning</type>
    </rule>
    <rule ref="SymPress.Functions.FunctionLength">
        <type>warning</type>
    </rule>
    <rule ref="SymPress.Variables.RedundantAssignment">
        <type>warning</type>
    </rule>
    <rule ref="SlevomatCodingStandard.Classes.RequireConstructorPropertyPromotion">
        <type>warning</type>
    </rule>
    <rule ref="SlevomatCodingStandard.ControlStructures.RequireTernaryOperator">
        <type>warning</type>
    </rule>
    <rule ref="SlevomatCodingStandard.Functions.ArrowFunctionDeclaration">
        <type>warning</type>
    </rule>
</ruleset>
