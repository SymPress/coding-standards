<?xml version="1.0"?>
<ruleset
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd"
    name="SymPress Coding Standards: E2E Tests"
>

    <!-- Check for cross-version support for PHP 8.5 and higher. -->
    <config name="testVersion" value="8.5-" />
    <config name="minimum_wp_version" value="7.0" />

    <file>./templates</file>
    <file>./index.php</file>

    <!-- Show sniff error codes and progress, and print JSON report. -->
    <arg value="sp" />
    <arg name="report" value="json"/>

    <rule ref="SymPress-Plugin" />

    <rule ref="SymPress.ControlStructures.DisallowElse">
        <exclude-pattern>*/templates/*</exclude-pattern>
    </rule>

    <rule ref="SymPress-Templates">
        <include-pattern>*/templates/*</include-pattern>
    </rule>

</ruleset>
